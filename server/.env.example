NODE_ENV=production
PORT=3000

# Postgres (Coolify internal URL)
DATABASE_URL=postgresql://moodly:CHANGE_ME@moodly-postgres:5432/moodly?schema=public

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API, e.g. https://api.moodly.app
BETTER_AUTH_URL=https://api.example.com
# Must match "scheme" in the app's app.json
APP_SCHEME=moodly
# Extra comma-separated origins (e.g. a web app). Optional.
TRUSTED_ORIGINS=

# Google OAuth (Web application client; redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_LIMIT=20

# MinIO / S3. S3_ENDPOINT must be reachable from phones (presigned URLs use it), e.g. https://s3.moodly.app
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=moodly

# RevenueCat
# Value you set as the webhook "Authorization header" in RevenueCat
REVENUECAT_WEBHOOK_SECRET=
# Secret API key (sk_...), used to verify entitlements server-side
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

FREE_CUSTOM_AFFIRMATION_LIMIT=5
