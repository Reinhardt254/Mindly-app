# API the app talks to. Restart Metro after changing this.
# Android emulator: http://10.0.2.2:3000 (reaches the host machine)
# Physical device: your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Sign-In (native account picker — not browser OAuth)
# Use the Web application OAuth client ID from Google Cloud Console.
# Must match GOOGLE_CLIENT_ID on the server (or be included in its clientId list).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional iOS OAuth client ID + reversed scheme (com.googleusercontent.apps.xxxxx)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# RevenueCat public SDK keys (goog_... / appl_...). Leave empty to disable purchases.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# When false, all premium features are unlocked and the paywall is disabled.
EXPO_PUBLIC_PREMIUM_ENABLED=true
